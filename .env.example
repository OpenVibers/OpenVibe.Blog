# ═══════════════════════════════════════════════════════════════
# openvibe.blog — environment configuration (names only; never commit values)
# Copy to .env for development. Production: /etc/openvibe/blog.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4810
HOST=127.0.0.1
NODE_ENV=development
# Public origin: canonical URLs, feeds, sitemaps and JSON-LD are built from it
BASE_URL=http://localhost:4810
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2)
TRUST_PROXY=2

# SQLite database (production unit: /var/lib/openvibe-blog/blog.db)
BLOG_DB_PATH=./data/blog.db

# OpenVibe.Network — SSO (OAuth2), JWKS, client-credentials tokens
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OAuth client `blog` (redirect https://openvibe.blog/auth/callback). The same client is Blog's
# service principal svc:blog for client-credentials grants (see README, "Grants").
OV_OAUTH_CLIENT_ID=blog
OV_OAUTH_CLIENT_SECRET=
# Production: https://openvibe.blog/auth/callback (default: BASE_URL + /auth/callback)
#OV_OAUTH_REDIRECT_URI=
# Cookies: Secure by default in production; set false for plain-http local development
#COOKIE_SECURE=false
# Signs the editor/comment form tokens (CSRF). Unset: random per process.
#BLOG_FORM_SECRET=

# The official blog (served at /): owners are Network subjects (usr_…), comma-separated
BLOG_OFFICIAL_OWNERS=
#BLOG_OFFICIAL_TITLE=The OpenVibe blog
#BLOG_OFFICIAL_DESCRIPTION=News and release notes from the OpenVibe network.

# OpenVibe.Media — attachments are Media object ids; bytes are served by Media
OV_MEDIA_URL=https://openvibe.media
OV_MEDIA_INTERNAL_URL=http://127.0.0.1:4100
# Media tenant/namespace for Blog's objects (media.object.read is granted for it)
BLOG_MEDIA_APP=blog
#BLOG_MEDIA_VERIFY_INTERVAL_MS=600000

# OpenVibe.Community — comment threads (referenced, never copied)
OV_COMMUNITY_URL=https://openvibe.community
OV_COMMUNITY_INTERNAL_URL=http://127.0.0.1:4200

# OpenVibe.Events — the outbox relay runs only when EVENTS_URL and OV_OAUTH_CLIENT_SECRET are set
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000

# Scheduled publication worker (in-process); off: BLOG_WORKER=off
#BLOG_WORKER=on
#BLOG_SCHEDULE_INTERVAL_MS=15000
#BLOG_WORKER_ID=

# Members-only (VIP) posts: 'none' = no entitlement service yet → fails closed
# (only the blog's members and staff can read them)
#BLOG_ENTITLEMENTS_PROVIDER=none

# Browser origins that may call /api/v1 with a Bearer Network JWT
#API_CORS_ORIGINS=https://openvibe.network,https://openvibe.live,https://openvibe.community,https://openvibe.media

# release.json (openvibe-shared/release): the deployed commit when git is not available
#RELEASE_COMMIT=
#MIN_CLIENT_RELEASE=
