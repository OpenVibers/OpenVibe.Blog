{
  "name": "openvibe-blog",
  "version": "0.1.0",
  "private": true,
  "description": "OpenVibe.Blog — the official OpenVibe blog and a blog for every member: drafts, immutable revisions, series, tags and categories, scheduling, feeds, sitemaps and Community comments, server-rendered and useful without JavaScript.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "test": "node test/run.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": ["openvibe", "blog", "publishing", "feeds"],
